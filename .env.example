# Environment
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dinewithme?schema=public

# Cloudflare R2 / S3-Compatible Storage
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com/your-bucket-name
R2_REGION=auto
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-bucket-name
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev  # Optional: Custom domain for public URLs

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# Paystack Payment Gateway
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxx

# Resend (transactional email) - without this, packages/email/src/service.ts
# silently no-ops and emails are never sent, with no error
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=DineWithMe <noreply@dinewithme.co>

# Analytics (optional)
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
ANALYTICS_ENABLED=false
ANALYTICS_DEBUG=false

# Sentry (error tracking, optional - the SDK no-ops with no DSN configured)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Upstash Redis (production rate limiting - falls back to in-memory if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Inngest (background job queue, optional in dev - Inngest Dev Server
# auto-discovers local functions with no keys needed; these are for
# production)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Mapbox (Discover map view - falls back to the static placeholder if unset)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Client-side (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ANALYTICS_KEY=

# Platform Admin (for seed script)
PLATFORM_ADMIN_EMAIL=admin@example.com

# Cron Job Security
CRON_SECRET=your-secret-token-here

# QR Token Secret (for check-in tokens)
QR_TOKEN_SECRET=your-qr-token-secret-change-in-production

# Bank Details Encryption (Restaurant.bankAccountNumber, §16.5 payouts)
BANK_DETAILS_ENCRYPTION_KEY=your-bank-details-encryption-key-change-in-production
