{
  "name": "dinewithme",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "seed": "cd scripts && npm run seed",
    "migrate:pre-deployment": "tsx scripts/pre-deployment-migration.ts",
    "test:concurrent-bookings": "vitest run tests/concurrent-bookings.test.ts",
    "test:state-machine": "vitest run tests/state-machine.test.ts",
    "test:refund-race": "vitest run tests/refund-race.test.ts",
    "test:dinner-cancellation": "vitest run tests/dinner-cancellation.test.ts",
    "test:payout-settlement": "vitest run tests/payout-settlement.test.ts",
    "test:user-sync": "echo 'User sync test - manual verification required'",
    "check:security": "echo 'Security check - verify headers and rate limiting'",
    "verify:database": "tsx scripts/verify-database.ts"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "tsx": "^4.21.0",
    "turbo": "^1.12.4",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "dotenv": "^17.3.1"
  }
}
