generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DINER
  RESTAURANT_ADMIN
  PLATFORM_ADMIN
}

enum RestaurantMemberRole {
  OWNER
  MANAGER
}

enum RestaurantStatus {
  PENDING
  ACTIVE
  PAUSED
}

enum RestaurantMediaType {
  HERO
  GALLERY
}

enum DinnerStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum SeatStatus {
  AVAILABLE
  HELD
  CONFIRMED
  ATTENDED
  COMPLETED
  CANCELLED
  EXPIRED
  NO_SHOW
  LEFT_EARLY
}

enum PaymentProvider {
  PAYSTACK
  YOCO
}

enum PaymentStatus {
  CREATED
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id             String   @id @default(cuid())
  authProviderId String   @unique
  email          String   @unique
  firstName      String?
  lastName       String?
  avatarUrl      String?
  role           Role     @default(DINER)
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  restaurantMemberships RestaurantMember[]
  auditLogs             AuditLog[]
  heldSeats             Seat[]             @relation("HeldSeats")
  confirmedSeats        Seat[]             @relation("ConfirmedSeats")
  trustEvents           TrustEvent[]
  authoredFeedback      Feedback[]         @relation("FeedbackAuthor")
  receivedFeedback      Feedback[]         @relation("FeedbackTarget")
  mutualInterestsA      MutualInterest[]   @relation("MutualInterestUserA")
  mutualInterestsB      MutualInterest[]   @relation("MutualInterestUserB")
  trustProfile          TrustProfile?
  paymentIntents        PaymentIntent[]
  themeSignals          UserThemeSignal[]
  reportsFiled          SafetyReport[]     @relation("ReportsFiled")
  reportsReceived       SafetyReport[]     @relation("ReportsReceived")
  reportsReviewed       SafetyReport[]     @relation("ReportsReviewed")
  verifiedDocuments     ComplianceDocument[]

  @@map("users")
}

model Restaurant {
  id                       String           @id @default(cuid())
  name                     String
  description              String?
  cuisine                  String?
  city                     String?
  address                  String?
  latitude                 Float?
  longitude                Float?
  phone                    String?
  website                  String?
  heroImageUrl             String?
  status                   RestaurantStatus @default(PENDING)
  defaultPricePerSeatCents Int?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  members             RestaurantMember[]
  media                RestaurantMedia[]
  dinners              Dinner[]
  enabledThemes        RestaurantEnabledTheme[]
  dinnerContexts       DinnerContext[]
  menuItems            MenuItem[]
  complianceDocuments  ComplianceDocument[]
  tables               RestaurantTable[]
  recurringSeries      RecurringDinnerSeries[]

  @@map("restaurants")
}

model RestaurantMember {
  id           String               @id @default(cuid())
  restaurantId String
  userId       String
  role         RestaurantMemberRole
  createdAt    DateTime             @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, userId])
  @@index([restaurantId])
  @@index([userId])
  @@map("restaurant_members")
}

model RestaurantMedia {
  id           String              @id @default(cuid())
  restaurantId String
  type         RestaurantMediaType
  url          String
  key          String // Storage key for deletion
  createdAt    DateTime            @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, type])
  @@map("restaurant_media")
}

model Theme {
  id                   String   @id @default(cuid())
  key                  String   @unique // e.g., "tech-innovators", "creative-minds"
  title                String   // e.g., "Tech Innovators"
  shortDescription     String   // Brief tagline
  whatToExpect         String   @db.Text // Detailed description
  boundaries           String   @db.Text // What's off-limits
  conversationStarters Json     // Array of starter questions
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  dinners              Dinner[]
  restaurantThemes     RestaurantEnabledTheme[]
  dinnerContexts       DinnerContext[]
  themePerformance     ThemePerformance?
  userSignals          UserThemeSignal[]
  recurringSeries      RecurringDinnerSeries[]

  @@index([key])
  @@index([isActive])
  @@map("themes")
}

model RestaurantEnabledTheme {
  id           String   @id @default(cuid())
  restaurantId String
  themeId      String
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  theme      Theme      @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, themeId])
  @@index([restaurantId])
  @@index([themeId])
  @@map("restaurant_enabled_themes")
}

model Dinner {
  id                String       @id @default(cuid())
  restaurantId      String
  themeId           String
  startsAt          DateTime
  endsAt            DateTime
  description       String?
  seatCount         Int
  status            DinnerStatus @default(SCHEDULED)
  pricePerSeatCents Int?
  seriesId          String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  restaurant      Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  theme           Theme                  @relation(fields: [themeId], references: [id])
  series          RecurringDinnerSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seats           Seat[]
  feedback        Feedback[]
  mutualInterests MutualInterest[]
  paymentIntents  PaymentIntent[]
  dinnerContext   DinnerContext?
  safetyReports   SafetyReport[]

  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([themeId])
  @@index([startsAt])
  @@index([seriesId])
  @@map("dinners")
}

model Seat {
  id                String     @id @default(cuid())
  dinnerId          String
  status            SeatStatus @default(AVAILABLE)
  heldByUserId      String?
  holdExpiresAt     DateTime?
  confirmedByUserId String?
  checkedInAt       DateTime?
  checkedOutAt      DateTime?
  dietaryNotes      String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  dinner        Dinner @relation(fields: [dinnerId], references: [id], onDelete: Cascade)
  heldByUser    User?  @relation("HeldSeats", fields: [heldByUserId], references: [id], onDelete: SetNull)
  confirmedByUser User? @relation("ConfirmedSeats", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  paymentIntents PaymentIntent[]

  @@index([dinnerId, status])
  @@index([heldByUserId])
  @@index([confirmedByUserId])
  @@map("seats")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorUserId String
  actionType String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([actionType])
  @@index([createdAt])
  @@map("audit_logs")
}

model TrustEvent {
  id               String         @id @default(cuid())
  userId           String
  type             TrustEventType
  weight           Float          // Positive or negative impact on trust score
  sourceDinnerId   String?        // Optional reference to dinner where event occurred
  metadata         Json?          // Additional context (seatId, feedbackId, etc.)
  createdAt        DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([sourceDinnerId])
  @@index([createdAt])
  @@map("trust_events")
}

model Feedback {
  id                String             @id @default(cuid())
  dinnerId          String
  authorId          String
  targetUserId      String?            // Null for table-level feedback
  overallSentiment  FeedbackSentiment
  comfortLevel      ComfortLevel
  wouldDineAgain    Boolean?
  notes             String?
  // 1-5 star rating from the Post-Dinner "How Was It?" screen. Nullable
  // because rows written before this column existed (and rows from a
  // skipped rating screen) have no value.
  rating            Int?
  // Multi-select vibe tags from the same screen (e.g. "GREAT_CONVERSATIONS",
  // "GOOD_FOOD"). Native Postgres array, defaults to empty rather than
  // null so callers can always treat it as a list.
  vibeTags          String[]           @default([])
  createdAt         DateTime           @default(now())

  dinner Dinner @relation(fields: [dinnerId], references: [id], onDelete: Cascade)
  author User   @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  // Bugfix: was onDelete: Cascade, contradicting the "Null for table-level
  // feedback" comment above - deleting a targeted user was deleting the
  // feedback that named them instead of nulling the target, losing data
  // that should survive account deletion. See the DB migration plan
  // artifact's §05 for the original finding.
  target User?  @relation("FeedbackTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([dinnerId])
  @@index([authorId])
  @@index([targetUserId])
  @@index([dinnerId, authorId])
  @@map("feedback")
}

model MutualInterest {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  dinnerId  String
  createdAt DateTime @default(now())

  userA  User   @relation("MutualInterestUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB  User   @relation("MutualInterestUserB", fields: [userBId], references: [id], onDelete: Cascade)
  dinner Dinner @relation(fields: [dinnerId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId, dinnerId], name: "unique_mutual_interest")
  @@index([userAId])
  @@index([userBId])
  @@index([dinnerId])
  @@map("mutual_interests")
}

enum TrustEventType {
  ATTENDED
  NO_SHOW
  LEFT_EARLY
  POSITIVE_FEEDBACK
  NEGATIVE_FEEDBACK
  REPORTED
  LATE_CANCELLATION
  CONFIRMED_ATTENDANCE
  POSITIVE_REVIEW
  NEGATIVE_REVIEW
}

enum FeedbackSentiment {
  GREAT
  GOOD
  NEUTRAL
  UNCOMFORTABLE
}

enum ComfortLevel {
  FULL
  MOSTLY
  LOW
}

model TrustProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  trustScore      Float    @default(0.5) // Bounded between 0 and 1, starts at 0.5
  attendanceRate  Float    @default(1.0) // Percentage of confirmed dinners attended (0-1)
  flagged         Boolean  @default(false) // True if user has repeated negative signals
  lastEvaluatedAt DateTime @default(now()) @updatedAt
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([trustScore])
  @@index([flagged])
  @@map("trust_profiles")
}

model PaymentIntent {
  id                String          @id @default(cuid())
  userId            String
  dinnerId          String
  seatId            String
  amount            Int             // Amount in cents
  currency          String          @default("ZAR")
  provider          PaymentProvider
  providerReference String?         // Reference from payment provider
  status            PaymentStatus   @default(CREATED)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dinner Dinner @relation(fields: [dinnerId], references: [id], onDelete: Cascade)
  seat   Seat   @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dinnerId])
  @@index([seatId])
  @@index([status])
  @@index([userId, status])
  @@map("payment_intents")
}

model WebhookEvent {
  id          String   @id @default(cuid())
  externalId  String   @unique // Event ID from payment provider
  type        String   // Event type (e.g., "charge.success")
  payload     Json     // Full webhook payload
  processedAt DateTime
  createdAt   DateTime @default(now())

  @@index([externalId])
  @@index([type])
  @@index([createdAt])
  @@map("webhook_events")
}

// ─── Theme Engine Data Collection ────────────────────────────────────────────

enum WeatherCondition {
  CLEAR
  CLOUDY
  RAINY
  STORMY
  COLD
  HOT
  WINDY
}

enum DayPeriod {
  LUNCH      // 11:00 - 15:00
  DINNER     // 17:00 - 21:00
  LATE_NIGHT // 21:00+
}

enum RestaurantType {
  FINE_DINING
  CASUAL
  BISTRO
  ROOFTOP
  OUTDOOR
  PRIVATE_DINING
  CAFE
  OTHER
}

enum PriceTier {
  BUDGET     // < R200/person
  MID        // R200-R500/person
  PREMIUM    // R500+/person
}

/// Snapshot of contextual data captured when a dinner completes.
/// This is the core record for the theme engine — every completed dinner
/// writes one row here. Over time this becomes the training data.
model DinnerContext {
  id             String           @id @default(cuid())
  dinnerId       String           @unique
  themeId        String
  restaurantId   String

  // Venue context
  city           String
  neighbourhood  String?
  restaurantType RestaurantType?
  cuisineType    String?
  priceTier      PriceTier?

  // Time context
  dayOfWeek      Int              // 0=Sunday, 6=Saturday
  dayPeriod      DayPeriod
  month          Int              // 1-12 for seasonal patterns
  season         String?          // "summer", "winter", etc.

  // Weather at time of dinner (fetched from API at dinner creation)
  weatherCondition WeatherCondition?
  temperatureCelsius Float?

  // Outcome metrics (populated when dinner completes)
  seatsBooked    Int              @default(0)
  seatsTotal     Int
  fillRate       Float?           // seatsBooked / seatsTotal
  attendanceRate Float?           // actually showed up / confirmed
  avgFeedbackScore Float?         // 1-5 derived from feedback
  connectionRate Float?           // % who said they made a meaningful connection
  wouldReturnRate Float?          // % who said they'd attend again
  mutualInterestCount Int         @default(0) // how many mutual matches happened

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  dinner         Dinner           @relation(fields: [dinnerId], references: [id], onDelete: Cascade)
  theme          Theme            @relation(fields: [themeId], references: [id])
  restaurant     Restaurant       @relation(fields: [restaurantId], references: [id])

  @@index([themeId])
  @@index([restaurantId])
  @@index([city])
  @@index([dayOfWeek])
  @@index([month])
  @@index([fillRate])
  @@index([avgFeedbackScore])
  @@map("dinner_contexts")
}

/// Aggregated performance stats per theme.
/// Updated after each dinner completes. Used for quick lookups
/// without scanning all dinner_contexts.
model ThemePerformance {
  id                  String   @id @default(cuid())
  themeId             String   @unique

  totalDinners        Int      @default(0)
  totalSeatsBooked    Int      @default(0)
  avgFillRate         Float?
  avgAttendanceRate   Float?
  avgFeedbackScore    Float?
  avgConnectionRate   Float?
  avgWouldReturnRate  Float?

  // Breakdown by context (stored as JSON for flexibility)
  // e.g. { "FINE_DINING": { avgScore: 4.2, count: 12 }, ... }
  byRestaurantType    Json?
  byCuisine           Json?
  byDayOfWeek         Json?
  byPriceTier         Json?
  byWeather           Json?
  byCity              Json?

  lastUpdatedAt       DateTime @default(now()) @updatedAt
  createdAt           DateTime @default(now())

  theme               Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@index([themeId])
  @@index([avgFeedbackScore])
  @@index([avgFillRate])
  @@map("theme_performance")
}

/// User-level theme preference signals.
/// Built from browsing behaviour + attendance history.
/// Powers personalised theme recommendations.
model UserThemeSignal {
  id              String   @id @default(cuid())
  userId          String
  themeId         String

  viewCount       Int      @default(0)   // times user viewed this theme's dinner
  bookingCount    Int      @default(0)   // times user booked this theme
  attendanceCount Int      @default(0)   // times user actually attended
  avgRatingGiven  Float?                 // avg score they gave dinners with this theme
  lastInteractedAt DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme           Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([userId, themeId])
  @@index([userId])
  @@index([themeId])
  @@index([bookingCount])
  @@map("user_theme_signals")
}

// ─── Menu, Trust & Safety, Compliance, Recurring Dinners, Tables ────────────
// Added per the DB migration plan artifact (744b324b-3277-4c94-b656-3179f8f1f413).
// See prisma/migrations/<timestamp>_add_menu_safety_compliance_tables/ for the
// hand-written migration SQL - this schema change has not been applied to any
// live database from this session (no DATABASE_URL available here).

enum MenuCourse {
  STARTER
  MAIN
  DESSERT
}

/// Backs the admin Restaurant Profile "Menu" section. Flat model tied
/// directly to Restaurant - no separate Menu container, since nothing in
/// the wireframe implies multiple named menus or menu versioning.
model MenuItem {
  id           String     @id @default(cuid())
  restaurantId String
  course       MenuCourse
  name         String
  description  String?
  priceCents   Int
  position     Int        @default(0)
  isAvailable  Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, course])
  @@map("menu_items")
}

enum SafetyReportReason {
  MADE_UNCOMFORTABLE
  INAPPROPRIATE_BEHAVIOR
  SAFETY_CONCERN
  OTHER
}

enum SafetyReportStatus {
  PENDING
  REVIEWED
  ACTIONED
  DISMISSED
}

/// Backs the Trust & Safety review queue. TrustEvent's generic type+Json
/// metadata isn't enough here - no reporter field, no status/workflow, no
/// reviewer, and every tab/filter on that screen would mean parsing
/// reason/status out of JSON.
model SafetyReport {
  id             String             @id @default(cuid())
  reporterId     String
  reportedUserId String?
  dinnerId       String?
  reason         SafetyReportReason
  reasonDetail   String?
  status         SafetyReportStatus @default(PENDING)
  resolution     String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  reporter      User    @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser  User?   @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: SetNull)
  dinner        Dinner? @relation(fields: [dinnerId], references: [id], onDelete: SetNull)
  reviewedBy    User?   @relation("ReportsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([dinnerId])
  @@index([status])
  @@index([reason])
  @@index([createdAt])
  @@map("safety_reports")
}

enum ComplianceDocType {
  BUSINESS_REGISTRATION
  FOOD_SAFETY_CERTIFICATE
  LIQUOR_LICENSE
  OTHER
}

/// Kept deliberately separate from RestaurantMedia: that model assumes
/// public, always-visible marketing images, while compliance PDFs are
/// private, admin-only, and need a verification lifecycle. Reusing
/// RestaurantMedia would need a visibility discriminator and risks a
/// private legal document leaking into a public gallery query that
/// doesn't filter by type.
model ComplianceDocument {
  id           String            @id @default(cuid())
  restaurantId String
  docType      ComplianceDocType
  fileName     String
  key          String // R2 storage key, mirrors RestaurantMedia's pattern
  url          String
  verifiedAt   DateTime?
  verifiedById String?
  createdAt    DateTime          @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  verifiedBy User?      @relation(fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([restaurantId, docType])
  @@map("compliance_documents")
}

/// The "Repeat Weekly" toggle needs a real recurrence record, not a
/// boolean on Dinner - a flag gives no way to cancel a single occurrence
/// without breaking the pattern, no way to edit "this one" vs "all future
/// occurrences," and no clean query for "which dinners came from this
/// recurrence." Note: this model alone doesn't make dinners appear weekly -
/// something still has to run the generator job (blocked on the job-queue
/// infrastructure being wired up, see packages/../inngest).
model RecurringDinnerSeries {
  id                String   @id @default(cuid())
  restaurantId      String
  themeId           String
  dayOfWeek         Int      // 0=Sunday..6=Saturday, matches DinnerContext's convention
  startTime         String   // "19:00", combined with dayOfWeek + endTime at generation time
  endTime           String
  seatCount         Int
  pricePerSeatCents Int?
  description       String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  theme      Theme      @relation(fields: [themeId], references: [id])
  dinners    Dinner[]

  @@index([restaurantId])
  @@index([isActive])
  @@map("recurring_dinner_series")
}

/// Restaurant-side table configuration (e.g. "2 four-tops, 1 eight-top") -
/// not diner party-size booking. Diner-side booking is unaffected: one Seat
/// row per booking call, exactly as today. Once populated, this is what the
/// diner-facing "Table Size" filter chip should query against - confirmed
/// separately that its `size` param is collected in the UI but currently
/// silently dropped, never forwarded to the dinners API.
model RestaurantTable {
  id           String     @id @default(cuid())
  restaurantId String
  capacity     Int // seats at this table, e.g. 4, 6, 8
  count        Int        @default(1) // how many tables of this capacity

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("restaurant_tables")
}
