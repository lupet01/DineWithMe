generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DINER
  RESTAURANT_ADMIN
  PLATFORM_ADMIN
}

enum RestaurantMemberRole {
  OWNER
  MANAGER
}

enum RestaurantStatus {
  PENDING
  ACTIVE
  PAUSED
  /// Permanent closure - historical dinners/seats/payments survive for
  /// diners' booking history and financial records; distinct from PAUSED,
  /// which is temporary and self-reversible. Reached only via an approved
  /// RestaurantClosureRequest, never a direct status write (§4.5.5/§16.7).
  ARCHIVED
}

enum RestaurantMediaType {
  HERO
  GALLERY
}

enum RestaurantGalleryRole {
  HERO
  GALLERY
  FEATURED
}

enum DinnerMediaKind {
  DINNER_LISTING
  PAST_DINNER_HIGHLIGHT
  PAST_DINNER_PRIVATE
}

enum DinnerMediaPromotionStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum DinnerStatus {
  // Not yet published — invisible on Discover, not bookable. Only a DRAFT
  // dinner's content (date/price/seats/description) can still be edited;
  // once Publish flips it to SCHEDULED, a guest may already be looking at
  // or booking it, so content locks for good. See wireframe §6.3/§6.4.
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum SeatStatus {
  AVAILABLE
  HELD
  CONFIRMED
  ATTENDED
  COMPLETED
  CANCELLED
  EXPIRED
  NO_SHOW
  LEFT_EARLY
}

enum PaymentProvider {
  PAYSTACK
  YOCO
}

enum PaymentStatus {
  CREATED
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id             String   @id @default(cuid())
  authProviderId String   @unique
  email          String   @unique
  firstName      String?
  lastName       String?
  avatarUrl      String?
  role           Role     @default(DINER)
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  restaurantMemberships RestaurantMember[]
  auditLogs             AuditLog[]
  heldSeats             Seat[]             @relation("HeldSeats")
  confirmedSeats        Seat[]             @relation("ConfirmedSeats")
  trustEvents           TrustEvent[]
  authoredFeedback      Feedback[]         @relation("FeedbackAuthor")
  receivedFeedback      Feedback[]         @relation("FeedbackTarget")
  mutualInterestsA      MutualInterest[]   @relation("MutualInterestUserA")
  mutualInterestsB      MutualInterest[]   @relation("MutualInterestUserB")
  trustProfile          TrustProfile?
  paymentIntents        PaymentIntent[]
  themeSignals          UserThemeSignal[]
  reportsFiled          SafetyReport[]     @relation("ReportsFiled")
  reportsReceived       SafetyReport[]     @relation("ReportsReceived")
  reportsReviewed       SafetyReport[]     @relation("ReportsReviewed")
  verifiedDocuments     ComplianceDocument[]
  teamInvitesSent       TeamInvite[]
  closureRequestsMade     RestaurantClosureRequest[] @relation("ClosureRequestedBy")
  closureRequestsReviewed RestaurantClosureRequest[] @relation("ClosureReviewedBy")

  @@map("users")
}

model Restaurant {
  id                       String           @id @default(cuid())
  name                     String
  description              String?
  cuisine                  String?
  city                     String?
  address                  String?
  latitude                 Float?
  longitude                Float?
  phone                    String?
  website                  String?
  // Business-level contact email, distinct from any Team member's personal
  // login email — shown on Restaurant Profile's Contact Information card.
  contactEmail             String?
  heroImageUrl             String?
  status                   RestaurantStatus @default(PENDING)
  defaultPricePerSeatCents Int?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  // Payout destination (§16.5). bankAccountNumber is stored AES-256-GCM
  // encrypted (see packages/db/src/utils/encryption.ts) - never queried,
  // filtered, or indexed on, only decrypted for display/payout processing.
  // bankDetailsVerifiedAt is cleared to null by the update path itself any
  // time bank details change, so a changed account can never silently
  // inherit a stale verification - only a fresh Platform Ops verify action
  // sets it again. Never save-and-verify in the same step.
  bankName                 String?
  bankAccountNumber        String?
  bankAccountHolderName    String?
  bankDetailsVerifiedAt    DateTime?

  // Onboarding Step 3 - Verification (§16.1). registrationNumber is
  // required at signup going forward (a real business filing is hard for
  // spam to fake); the rest are optional anti-spam/attribution signals.
  // All nullable so restaurants approved before this column existed don't
  // retroactively need to backfill anything - surfaced as an optional
  // "add this info" prompt on Restaurant Profile, never a block.
  registrationNumber       String?
  googleBusinessUrl        String?
  instagramHandle          String?
  facebookUrl              String?
  referralSource           String?

  // Set when status transitions to PAUSED (self-serve, instant,
  // reversible - distinct from ARCHIVED, which is permanent and only
  // reached via an approved RestaurantClosureRequest). Cleared back to
  // null on reactivation.
  pausedAt                 DateTime?

  // Set the first time the Dashboard's one-time "You're Live!" moment is
  // actually shown to the owner, client-side, after a PENDING -> ACTIVE
  // approval (§16.1). Null means "next Dashboard load should show it."
  // Reactivating from PAUSED never clears this - that restaurant already
  // had its moment. Backfilled to non-null for restaurants that were
  // already ACTIVE/PAUSED before this column existed, so it only ever
  // fires for approvals going forward.
  liveMomentSeenAt         DateTime?

  // Restaurant Profile's Operating Hours card. Json shape:
  // { mon: {open: "11:00", close: "22:00", closed: false}, tue: {...}, ... }
  // for all seven lowercase-3-letter day keys. Null means never set - the
  // card renders every day with empty open/close inputs and closed
  // unchecked, not an error state.
  operatingHours           Json?

  // Settings page's Notification Preferences card (§16.6 wireframe).
  // Sent to this account's email only for now - no WhatsApp delivery path
  // for restaurant-side notifications yet.
  notifyNewBooking            Boolean @default(true)
  notifyCancellation          Boolean @default(true)
  notifyLowFillRateWarning    Boolean @default(true)

  members             RestaurantMember[]
  media                RestaurantMedia[]
  mediaAssets          MediaAsset[]
  galleryItems         RestaurantGalleryItem[]
  dinners              Dinner[]
  enabledThemes        RestaurantEnabledTheme[]
  dinnerContexts       DinnerContext[]
  menuItems            MenuItem[]
  meals                Meal[]
  complianceDocuments  ComplianceDocument[]
  tables               RestaurantTable[]
  recurringSeries      RecurringDinnerSeries[]
  payouts              Payout[]
  teamInvites          TeamInvite[]
  closureRequests      RestaurantClosureRequest[]

  @@map("restaurants")
}

enum RestaurantClosureRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Settings' Danger Zone "Close Restaurant" action doesn't close the
/// restaurant directly - closing has downstream effects on payouts,
/// bookings, and historical data, so it creates a review request instead
/// (same posture as the original PENDING -> ACTIVE approval, just for the
/// opposite end of the lifecycle). Approving sets Restaurant.status =
/// ARCHIVED; rejecting just dismisses the request, restaurant stays as it
/// was.
model RestaurantClosureRequest {
  id               String                          @id @default(cuid())
  restaurantId     String
  requestedByUserId String
  reason           String                          @db.Text
  status           RestaurantClosureRequestStatus  @default(PENDING)
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime                        @default(now())

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  requestedBy  User       @relation("ClosureRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  reviewedBy   User?      @relation("ClosureReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([status])
  @@map("restaurant_closure_requests")
}

model RestaurantMember {
  id           String               @id @default(cuid())
  restaurantId String
  userId       String
  role         RestaurantMemberRole
  createdAt    DateTime             @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, userId])
  @@index([restaurantId])
  @@index([userId])
  @@map("restaurant_members")
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

/// One shared model backing both the Restaurant Team invite (§6.2.1) and
/// the Platform Team invite (§7.8) - the only difference is whether
/// restaurantId is set. Deliberately stores the invite by email only,
/// never a userId up front: this app has no user-pre-provisioning path
/// (apps/web/src/app/api/auth/sync/route.ts only ever creates a User row
/// from a live Clerk session, User.authProviderId is required+unique), so
/// an invitee who hasn't signed up yet literally cannot be referenced by
/// a User row until they do. Acceptance links the invite to a User at
/// that point, not before.
///
/// role is a plain string, not RestaurantMemberRole, because a platform
/// invite (restaurantId null) grants Role.PLATFORM_ADMIN - a completely
/// different enum - rather than an OWNER/MANAGER value; validated at the
/// action layer against whichever enum applies for that invite's shape.
model TeamInvite {
  id              String            @id @default(cuid())
  email           String
  restaurantId    String?
  role            String
  token           String            @unique
  status          TeamInviteStatus  @default(PENDING)
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime          @default(now())

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  invitedBy  User        @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([email])
  @@index([status])
  @@map("team_invites")
}

// Superseded by MediaAsset + RestaurantGalleryItem below - kept as the
// pre-restructure baseline until the backfill migration is confirmed
// complete for every restaurant, see prisma/migrations and
// packages/db/src/scripts/backfill-restaurant-gallery.ts.
model RestaurantMedia {
  id           String              @id @default(cuid())
  restaurantId String
  type         RestaurantMediaType
  url          String
  key          String // Storage key for deletion
  createdAt    DateTime            @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, type])
  @@map("restaurant_media")
}

// One stored photo per restaurant - the shared library everything else
// (gallery items, dish photos, dinner listing/table photos) references
// instead of storing its own copy. See Implementation Guide §16.6.
model MediaAsset {
  id           String   @id @default(cuid())
  restaurantId String
  url          String
  key          String // Storage key for deletion, mirrors RestaurantMedia's own key field
  caption      String?
  uploadedAt   DateTime @default(now())

  restaurant   Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  galleryItems RestaurantGalleryItem[]
  dinnerMedia  DinnerMedia[]
  menuItems    MenuItem[]

  @@index([restaurantId])
  @@map("media_assets")
}

// Restructures RestaurantMedia into a join against MediaAsset rather than
// storing the url itself. restaurantId is kept denormalized (in addition to
// mediaAsset.restaurantId) for cheap per-restaurant gallery queries.
model RestaurantGalleryItem {
  id           String                @id @default(cuid())
  restaurantId String
  mediaAssetId String
  role         RestaurantGalleryRole
  displayOrder Int                   @default(0)
  createdAt    DateTime              @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, role])
  @@map("restaurant_gallery_items")
}

model Theme {
  id                   String   @id @default(cuid())
  key                  String   @unique // e.g., "tech-innovators", "creative-minds"
  title                String   // e.g., "Tech Innovators"
  shortDescription     String   // Brief tagline
  whatToExpect         String   @db.Text // Detailed description
  boundaries           String   @db.Text // What's off-limits
  conversationStarters Json     // Array of starter questions
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  dinners              Dinner[]
  restaurantThemes     RestaurantEnabledTheme[]
  dinnerContexts       DinnerContext[]
  themePerformance     ThemePerformance?
  userSignals          UserThemeSignal[]
  recurringSeries      RecurringDinnerSeries[]
  icebreakers          ThemeIcebreaker[]

  @@index([key])
  @@index([isActive])
  @@map("themes")
}

/// One row per starter question, replacing Theme.conversationStarters'
/// flat JSON array - a JSON array can't be aggregated or ranked in SQL,
/// which was the whole point of tracking "what starters do people
/// actually use" (§16.4). usageCount increments each time a starter is
/// shown to a confirmed guest on Booked Dinner View; avgRating has no
/// real data source yet (no per-starter rating UI exists anywhere), so it
/// stays null rather than being fabricated.
model ThemeIcebreaker {
  id           String   @id @default(cuid())
  themeId      String
  text         String   @db.Text
  displayOrder Int      @default(0)
  usageCount   Int      @default(0)
  avgRating    Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@index([themeId])
  @@map("theme_icebreakers")
}

model RestaurantEnabledTheme {
  id           String   @id @default(cuid())
  restaurantId String
  themeId      String
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  theme      Theme      @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, themeId])
  @@index([restaurantId])
  @@index([themeId])
  @@map("restaurant_enabled_themes")
}

// Recovered from the live database (§ restore pass) - present as a real
// Postgres enum with an index and real data (18 of 22 dinners set) but
// missing from schema.prisma, evidently dropped by accident during the
// local-master merge reconciliation. Ties to the Theme Engine's
// Conversation Style concept (Implementation Guide §16.4).
enum ConversationStyle {
  STRUCTURED_ICEBREAKERS
  OPEN_ENDED
  DEEP_AND_MEANINGFUL
  LIGHT_AND_CASUAL
}

model Dinner {
  id                String             @id @default(cuid())
  restaurantId      String
  themeId           String
  mealId            String?
  startsAt          DateTime
  endsAt            DateTime
  description       String?
  seatCount         Int
  status            DinnerStatus       @default(SCHEDULED)
  pricePerSeatCents Int?
  seriesId          String?
  conversationStyle ConversationStyle?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  restaurant      Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  theme           Theme                  @relation(fields: [themeId], references: [id])
  meal            Meal?                  @relation(fields: [mealId], references: [id], onDelete: SetNull)
  series          RecurringDinnerSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seats           Seat[]
  feedback        Feedback[]
  mutualInterests MutualInterest[]
  paymentIntents  PaymentIntent[]
  dinnerContext   DinnerContext?
  safetyReports   SafetyReport[]
  dinnerMedia     DinnerMedia[]
  payout          Payout?

  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([themeId])
  @@index([mealId])
  @@index([startsAt])
  @@index([seriesId])
  @@index([conversationStyle])
  @@map("dinners")
}

// Per-dinner photo join - listing photos (public, restaurant's own
// food/venue shots, go live immediately, no moderation) and table photos
// (private by default, may show real guests; "Promote" sends one through
// Photo Moderation to become a listing photo). See Implementation Guide
// §16.6/§16.8.
model DinnerMedia {
  id              String                     @id @default(cuid())
  dinnerId        String
  mediaAssetId    String
  kind            DinnerMediaKind
  displayOrder    Int                        @default(0)
  promotionStatus DinnerMediaPromotionStatus @default(NONE)
  createdAt       DateTime                   @default(now())

  dinner     Dinner     @relation(fields: [dinnerId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([dinnerId])
  @@index([dinnerId, kind])
  @@map("dinner_media")
}

model Seat {
  id                String     @id @default(cuid())
  dinnerId          String
  status            SeatStatus @default(AVAILABLE)
  heldByUserId      String?
  holdExpiresAt     DateTime?
  confirmedByUserId String?
  checkedInAt       DateTime?
  checkedOutAt      DateTime?
  dietaryNotes      String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  dinner        Dinner @relation(fields: [dinnerId], references: [id], onDelete: Cascade)
  heldByUser    User?  @relation("HeldSeats", fields: [heldByUserId], references: [id], onDelete: SetNull)
  confirmedByUser User? @relation("ConfirmedSeats", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  paymentIntents PaymentIntent[]

  @@index([dinnerId, status])
  @@index([heldByUserId])
  @@index([confirmedByUserId])
  @@map("seats")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorUserId String
  actionType String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([actionType])
  @@index([createdAt])
  @@map("audit_logs")
}

model TrustEvent {
  id               String         @id @default(cuid())
  userId           String
  type             TrustEventType
  weight           Float          // Positive or negative impact on trust score
  sourceDinnerId   String?        // Optional reference to dinner where event occurred
  metadata         Json?          // Additional context (seatId, feedbackId, etc.)
  createdAt        DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([sourceDinnerId])
  @@index([createdAt])
  @@map("trust_events")
}

model Feedback {
  id                String             @id @default(cuid())
  dinnerId          String
  authorId          String
  targetUserId      String?            // Null for table-level feedback
  overallSentiment  FeedbackSentiment
  comfortLevel      ComfortLevel
  wouldDineAgain    Boolean?
  notes             String?
  // 1-5 star rating from the Post-Dinner "How Was It?" screen. Nullable
  // because rows written before this column existed (and rows from a
  // skipped rating screen) have no value.
  rating            Int?
  // Multi-select vibe tags from the same screen (e.g. "GREAT_CONVERSATIONS",
  // "GOOD_FOOD"). Native Postgres array, defaults to empty rather than
  // null so callers can always treat it as a list.
  vibeTags          String[]           @default([])
  // Restaurant-only memo attached to a guest's table-level review, set from
  // the Reviews Inbox (/admin/reviews). Internal to the restaurant - never
  // shown to the guest or exposed on any diner-facing feedback record.
  restaurantNote    String?
  createdAt         DateTime           @default(now())

  dinner Dinner @relation(fields: [dinnerId], references: [id], onDelete: Cascade)
  author User   @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  // Bugfix: was onDelete: Cascade, contradicting the "Null for table-level
  // feedback" comment above - deleting a targeted user was deleting the
  // feedback that named them instead of nulling the target, losing data
  // that should survive account deletion. See the DB migration plan
  // artifact's §05 for the original finding.
  target User?  @relation("FeedbackTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([dinnerId])
  @@index([authorId])
  @@index([targetUserId])
  @@index([dinnerId, authorId])
  @@map("feedback")
}

model MutualInterest {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  dinnerId  String
  createdAt DateTime @default(now())

  userA  User   @relation("MutualInterestUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB  User   @relation("MutualInterestUserB", fields: [userBId], references: [id], onDelete: Cascade)
  dinner Dinner @relation(fields: [dinnerId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId, dinnerId], name: "unique_mutual_interest")
  @@index([userAId])
  @@index([userBId])
  @@index([dinnerId])
  @@map("mutual_interests")
}

enum TrustEventType {
  ATTENDED
  NO_SHOW
  LEFT_EARLY
  POSITIVE_FEEDBACK
  NEGATIVE_FEEDBACK
  REPORTED
  LATE_CANCELLATION
  CONFIRMED_ATTENDANCE
  POSITIVE_REVIEW
  NEGATIVE_REVIEW
}

enum FeedbackSentiment {
  GREAT
  GOOD
  NEUTRAL
  UNCOMFORTABLE
}

enum ComfortLevel {
  FULL
  MOSTLY
  LOW
}

model TrustProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  trustScore      Float    @default(0.5) // Bounded between 0 and 1, starts at 0.5
  attendanceRate  Float    @default(1.0) // Percentage of confirmed dinners attended (0-1)
  flagged         Boolean  @default(false) // True if user has repeated negative signals
  lastEvaluatedAt DateTime @default(now()) @updatedAt
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([trustScore])
  @@index([flagged])
  @@map("trust_profiles")
}

model PaymentIntent {
  id                String          @id @default(cuid())
  userId            String
  dinnerId          String
  seatId            String
  amount            Int             // Amount in cents
  currency          String          @default("ZAR")
  provider          PaymentProvider
  providerReference String?         // Reference from payment provider
  status            PaymentStatus   @default(CREATED)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dinner Dinner @relation(fields: [dinnerId], references: [id], onDelete: Cascade)
  seat   Seat   @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dinnerId])
  @@index([seatId])
  @@index([status])
  @@index([userId, status])
  @@map("payment_intents")
}

enum PayoutStatus {
  HELD
  READY
  PAID
}

/// One row per restaurant/dinner payout - how much a completed,
/// non-refunded dinner nets a restaurant after commission, and whether
/// it's been paid. Created HELD on dinner completion, computed from
/// confirmed seats x Dinner.pricePerSeatCents x the platform commission
/// rate (§16.5) - the booking fee is never part of a restaurant's payout,
/// the platform keeps all of it. Moves to READY once the post-dinner
/// dispute/hold window closes (packages/config/src/payout-policy.ts),
/// PAID once a Platform Ops admin processes it (manual v1, no Paystack
/// Transfers automation yet).
model Payout {
  id                    String       @id @default(cuid())
  restaurantId          String
  dinnerId              String       @unique

  grossAmountCents      Int          // confirmed seats x Dinner.pricePerSeatCents
  commissionAmountCents Int          // platform's cut of grossAmountCents
  bookingFeeCents       Int          // collected but never owed to the restaurant - informational only
  netAmountCents        Int          // grossAmountCents - commissionAmountCents, what the restaurant is actually paid

  status                PayoutStatus @default(HELD)
  scheduledAt           DateTime     // when this becomes eligible to move HELD -> READY
  paidAt                DateTime?

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dinner     Dinner     @relation(fields: [dinnerId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([status])
  @@map("payouts")
}

model WebhookEvent {
  id          String   @id @default(cuid())
  externalId  String   @unique // Event ID from payment provider
  type        String   // Event type (e.g., "charge.success")
  payload     Json     // Full webhook payload
  processedAt DateTime
  createdAt   DateTime @default(now())

  @@index([externalId])
  @@index([type])
  @@index([createdAt])
  @@map("webhook_events")
}

// ─── Theme Engine Data Collection ────────────────────────────────────────────

enum WeatherCondition {
  CLEAR
  CLOUDY
  RAINY
  STORMY
  COLD
  HOT
  WINDY
}

enum DayPeriod {
  LUNCH      // 11:00 - 15:00
  DINNER     // 17:00 - 21:00
  LATE_NIGHT // 21:00+
}

enum RestaurantType {
  FINE_DINING
  CASUAL
  BISTRO
  ROOFTOP
  OUTDOOR
  PRIVATE_DINING
  CAFE
  OTHER
}

enum PriceTier {
  BUDGET     // < R200/person
  MID        // R200-R500/person
  PREMIUM    // R500+/person
}

/// Snapshot of contextual data captured when a dinner completes.
/// This is the core record for the theme engine — every completed dinner
/// writes one row here. Over time this becomes the training data.
model DinnerContext {
  id             String           @id @default(cuid())
  dinnerId       String           @unique
  themeId        String
  restaurantId   String

  // Venue context
  city           String
  neighbourhood  String?
  restaurantType RestaurantType?
  cuisineType    String?
  priceTier      PriceTier?

  // Time context
  dayOfWeek      Int              // 0=Sunday, 6=Saturday
  dayPeriod      DayPeriod
  month          Int              // 1-12 for seasonal patterns
  season         String?          // "summer", "winter", etc.

  // Weather at time of dinner (fetched from API at dinner creation)
  weatherCondition WeatherCondition?
  temperatureCelsius Float?

  // Outcome metrics (populated when dinner completes)
  seatsBooked    Int              @default(0)
  seatsTotal     Int
  fillRate       Float?           // seatsBooked / seatsTotal
  attendanceRate Float?           // actually showed up / confirmed
  avgFeedbackScore Float?         // 1-5 derived from feedback
  connectionRate Float?           // % who said they made a meaningful connection
  wouldReturnRate Float?          // % who said they'd attend again
  mutualInterestCount Int         @default(0) // how many mutual matches happened

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Mirrors themeId, added for MealPerformance parity (§16.6) - nullable
  // since not every dinner has a Meal assigned, unlike Theme which is
  // required. Schema only: DinnerContext rows are never actually created
  // anywhere in this codebase today (no weather/seasonal population job
  // exists for Theme either), so this column stays unpopulated until that
  // separate, pre-existing gap is addressed - MealPerformance's own
  // aggregation reads directly from Dinner/Seat/Feedback instead of through
  // this table.
  mealId         String?

  dinner         Dinner           @relation(fields: [dinnerId], references: [id], onDelete: Cascade)
  theme          Theme            @relation(fields: [themeId], references: [id])
  meal           Meal?            @relation(fields: [mealId], references: [id], onDelete: SetNull)
  restaurant     Restaurant       @relation(fields: [restaurantId], references: [id])

  @@index([themeId])
  @@index([mealId])
  @@index([restaurantId])
  @@index([city])
  @@index([dayOfWeek])
  @@index([month])
  @@index([fillRate])
  @@index([avgFeedbackScore])
  @@map("dinner_contexts")
}

/// Aggregated performance stats per theme.
/// Updated after each dinner completes. Used for quick lookups
/// without scanning all dinner_contexts.
model ThemePerformance {
  id                  String   @id @default(cuid())
  themeId             String   @unique

  totalDinners        Int      @default(0)
  totalSeatsBooked    Int      @default(0)
  avgFillRate         Float?
  avgAttendanceRate   Float?
  avgFeedbackScore    Float?
  avgConnectionRate   Float?
  avgWouldReturnRate  Float?

  // Breakdown by context (stored as JSON for flexibility)
  // e.g. { "FINE_DINING": { avgScore: 4.2, count: 12 }, ... }
  byRestaurantType    Json?
  byCuisine           Json?
  byDayOfWeek         Json?
  byPriceTier         Json?
  byWeather           Json?
  byCity              Json?

  lastUpdatedAt       DateTime @default(now()) @updatedAt
  createdAt           DateTime @default(now())

  theme               Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@index([themeId])
  @@index([avgFeedbackScore])
  @@index([avgFillRate])
  @@map("theme_performance")
}

/// User-level theme preference signals.
/// Built from browsing behaviour + attendance history.
/// Powers personalised theme recommendations.
model UserThemeSignal {
  id              String   @id @default(cuid())
  userId          String
  themeId         String

  viewCount       Int      @default(0)   // times user viewed this theme's dinner
  bookingCount    Int      @default(0)   // times user booked this theme
  attendanceCount Int      @default(0)   // times user actually attended
  avgRatingGiven  Float?                 // avg score they gave dinners with this theme
  lastInteractedAt DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme           Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([userId, themeId])
  @@index([userId])
  @@index([themeId])
  @@index([bookingCount])
  @@map("user_theme_signals")
}

// ─── Menu, Trust & Safety, Compliance, Recurring Dinners, Tables ────────────
// Added per the DB migration plan artifact (744b324b-3277-4c94-b656-3179f8f1f413).
// See prisma/migrations/<timestamp>_add_menu_safety_compliance_tables/ for the
// hand-written migration SQL - this schema change has not been applied to any
// live database from this session (no DATABASE_URL available here).

enum MenuCourse {
  STARTER
  MAIN
  DESSERT
}

enum DietaryTag {
  VEGETARIAN
  VEGAN
  PESCATARIAN
  GLUTEN_FREE
  DAIRY_FREE
  NUT_FREE
  HALAL
  KOSHER
  CONTAINS_SHELLFISH
  SPICY
}

/// Backs the admin Restaurant Profile "Menu" section (Dish Library). Flat
/// model tied directly to Restaurant - no separate Menu container, since
/// nothing in the wireframe implies multiple named menus or menu
/// versioning. A dish entered here is the reusable building block a Meal
/// assembles from (MealCourseOption) - no longer read directly by any
/// diner-facing screen once Meals exist.
model MenuItem {
  id           String       @id @default(cuid())
  restaurantId String
  course       MenuCourse
  name         String
  description  String?
  ingredients  String?
  priceCents   Int
  position     Int          @default(0)
  isAvailable  Boolean      @default(true)
  mediaAssetId String?
  dietaryTags  DietaryTag[] @default([])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  mealCourseOptions MealCourseOption[]

  @@index([restaurantId])
  @@index([restaurantId, course])
  @@map("menu_items")
}

/// A reusable, restaurant-scoped named menu - the thing Create Dinner picks
/// from a dropdown, the same way it already picks a Theme. Assembled from
/// the Dish Library (MenuItem) via MealCourse/MealCourseOption, never
/// duplicating dish data.
model Meal {
  id                         String   @id @default(cuid())
  restaurantId               String
  name                       String
  suggestedPricePerSeatCents Int
  isActive                   Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  restaurant     Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  courses        MealCourse[]
  dinners        Dinner[]
  dinnerContexts DinnerContext[]
  performance    MealPerformance?

  @@index([restaurantId])
  @@map("meals")
}

/// Aggregated performance stats per Meal, mirroring ThemePerformance's
/// outcome metrics. Recomputed by the complete-dinners cron every time one
/// of that Meal's dinners is marked COMPLETED - reads directly from
/// Dinner/Seat/Feedback/MutualInterest rather than through DinnerContext,
/// since DinnerContext's population job (weather/seasonal context) doesn't
/// exist for Theme either and is out of scope here.
model MealPerformance {
  id                 String   @id @default(cuid())
  mealId             String   @unique

  totalDinners       Int      @default(0)
  totalSeatsBooked   Int      @default(0)
  avgFillRate        Float?
  avgAttendanceRate  Float?
  avgFeedbackScore   Float?
  avgConnectionRate  Float?
  avgWouldReturnRate Float?

  lastUpdatedAt      DateTime @default(now()) @updatedAt
  createdAt          DateTime @default(now())

  meal               Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([avgFeedbackScore])
  @@index([avgFillRate])
  @@map("meal_performance")
}

/// One course slot within a Meal (Starter/Main/Dessert).
model MealCourse {
  id           String     @id @default(cuid())
  mealId       String
  courseType   MenuCourse
  displayOrder Int        @default(0)

  meal    Meal               @relation(fields: [mealId], references: [id], onDelete: Cascade)
  options MealCourseOption[]

  @@index([mealId])
  @@map("meal_courses")
}

/// One dish filling a course slot - up to 3 per course. Joins to the Dish
/// Library (MenuItem) rather than duplicating dish data.
model MealCourseOption {
  id           String @id @default(cuid())
  mealCourseId String
  menuItemId   String

  mealCourse MealCourse @relation(fields: [mealCourseId], references: [id], onDelete: Cascade)
  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([mealCourseId])
  @@index([menuItemId])
  @@map("meal_course_options")
}

enum SafetyReportReason {
  MADE_UNCOMFORTABLE
  INAPPROPRIATE_BEHAVIOR
  SAFETY_CONCERN
  OTHER
}

enum SafetyReportStatus {
  PENDING
  REVIEWED
  ACTIONED
  DISMISSED
}

/// Backs the Trust & Safety review queue. TrustEvent's generic type+Json
/// metadata isn't enough here - no reporter field, no status/workflow, no
/// reviewer, and every tab/filter on that screen would mean parsing
/// reason/status out of JSON.
model SafetyReport {
  id             String             @id @default(cuid())
  reporterId     String
  reportedUserId String?
  dinnerId       String?
  reason         SafetyReportReason
  reasonDetail   String?
  status         SafetyReportStatus @default(PENDING)
  resolution     String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  reporter      User    @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser  User?   @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: SetNull)
  dinner        Dinner? @relation(fields: [dinnerId], references: [id], onDelete: SetNull)
  reviewedBy    User?   @relation("ReportsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([dinnerId])
  @@index([status])
  @@index([reason])
  @@index([createdAt])
  @@map("safety_reports")
}

enum ComplianceDocType {
  BUSINESS_REGISTRATION
  FOOD_SAFETY_CERTIFICATE
  LIQUOR_LICENSE
  OTHER
}

/// Kept deliberately separate from RestaurantMedia: that model assumes
/// public, always-visible marketing images, while compliance PDFs are
/// private, admin-only, and need a verification lifecycle. Reusing
/// RestaurantMedia would need a visibility discriminator and risks a
/// private legal document leaking into a public gallery query that
/// doesn't filter by type.
model ComplianceDocument {
  id             String            @id @default(cuid())
  restaurantId   String
  docType        ComplianceDocType
  fileName       String
  key            String // R2 storage key, mirrors RestaurantMedia's pattern
  url            String
  verifiedAt     DateTime?
  verifiedById   String?
  rejectedAt     DateTime?
  rejectionReason String?
  createdAt      DateTime          @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  verifiedBy User?      @relation(fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([restaurantId, docType])
  @@map("compliance_documents")
}

/// The "Repeat Weekly" toggle needs a real recurrence record, not a
/// boolean on Dinner - a flag gives no way to cancel a single occurrence
/// without breaking the pattern, no way to edit "this one" vs "all future
/// occurrences," and no clean query for "which dinners came from this
/// recurrence." Note: this model alone doesn't make dinners appear weekly -
/// something still has to run the generator job (blocked on the job-queue
/// infrastructure being wired up, see packages/../inngest).
model RecurringDinnerSeries {
  id                String   @id @default(cuid())
  restaurantId      String
  themeId           String
  dayOfWeek         Int      // 0=Sunday..6=Saturday, matches DinnerContext's convention
  startTime         String   // "19:00", combined with dayOfWeek + endTime at generation time
  endTime           String
  seatCount         Int
  pricePerSeatCents Int?
  description       String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  theme      Theme      @relation(fields: [themeId], references: [id])
  dinners    Dinner[]

  @@index([restaurantId])
  @@index([isActive])
  @@map("recurring_dinner_series")
}

/// Restaurant-side table configuration (e.g. "2 four-tops, 1 eight-top") -
/// not diner party-size booking. Diner-side booking is unaffected: one Seat
/// row per booking call, exactly as today. Once populated, this is what the
/// diner-facing "Table Size" filter chip should query against - confirmed
/// separately that its `size` param is collected in the UI but currently
/// silently dropped, never forwarded to the dinners API.
model RestaurantTable {
  id           String     @id @default(cuid())
  restaurantId String
  capacity     Int // seats at this table, e.g. 4, 6, 8
  count        Int        @default(1) // how many tables of this capacity

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("restaurant_tables")
}
